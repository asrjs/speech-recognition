{
  "name": "@asrjs/speech-recognition",
  "version": "0.2.0",
  "description": "Speech-first TypeScript runtime for browser and local Node.js inference",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asrjs/speech-recognition.git"
  },
  "keywords": [
    "asr",
    "speech-recognition",
    "speech-to-text",
    "onnx",
    "webgpu",
    "wasm",
    "nemo",
    "whisper"
  ],
  "bugs": {
    "url": "https://github.com/asrjs/speech-recognition/issues"
  },
  "homepage": "https://github.com/asrjs/speech-recognition#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./builtins": {
      "types": "./dist/builtins.d.ts",
      "import": "./dist/builtins.js",
      "default": "./dist/builtins.js"
    },
    "./io": {
      "types": "./dist/io.d.ts",
      "import": "./dist/io.js",
      "default": "./dist/io.js"
    },
    "./io/node": {
      "types": "./dist/io-node.d.ts",
      "import": "./dist/io-node.js",
      "default": "./dist/io-node.js"
    },
    "./inference": {
      "types": "./dist/inference.d.ts",
      "import": "./dist/inference.js",
      "default": "./dist/inference.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./browser/media": {
      "types": "./dist/browser-media.d.ts",
      "import": "./dist/browser-media.js",
      "default": "./dist/browser-media.js"
    },
    "./realtime": {
      "types": "./dist/realtime.d.ts",
      "import": "./dist/realtime.js",
      "default": "./dist/realtime.js"
    },
    "./bench": {
      "types": "./dist/bench.d.ts",
      "import": "./dist/bench.js",
      "default": "./dist/bench.js"
    },
    "./bench/browser": {
      "types": "./dist/bench-browser.d.ts",
      "import": "./dist/bench-browser.js",
      "default": "./dist/bench-browser.js"
    },
    "./datasets": {
      "types": "./dist/datasets.d.ts",
      "import": "./dist/datasets.js",
      "default": "./dist/datasets.js"
    },
    "./quality": {
      "types": "./dist/quality.d.ts",
      "import": "./dist/quality.js",
      "default": "./dist/quality.js"
    },
    "./chunking": {
      "types": "./dist/chunking.d.ts",
      "import": "./dist/chunking.js",
      "default": "./dist/chunking.js"
    },
    "./post-processing": {
      "types": "./dist/post-processing.d.ts",
      "import": "./dist/post-processing.js",
      "default": "./dist/post-processing.js"
    },
    "./alignment": {
      "types": "./dist/alignment.d.ts",
      "import": "./dist/alignment.js",
      "default": "./dist/alignment.js"
    },
    "./presets": {
      "types": "./dist/presets/index.d.ts",
      "import": "./dist/presets/index.js",
      "default": "./dist/presets/index.js"
    },
    "./pipeline": {
      "types": "./dist/pipeline.d.ts",
      "import": "./dist/pipeline.js",
      "default": "./dist/pipeline.js"
    },
    "./tokenizers": {
      "types": "./dist/tokenizers.d.ts",
      "import": "./dist/tokenizers.js",
      "default": "./dist/tokenizers.js"
    },
    "./models/*": {
      "types": "./dist/models/*.d.ts",
      "import": "./dist/models/*.js",
      "default": "./dist/models/*.js"
    },
    "./models/whisper-seq2seq": {
      "types": "./dist/models/whisper-seq2seq/index.d.ts",
      "import": "./dist/models/whisper-seq2seq/index.js",
      "default": "./dist/models/whisper-seq2seq/index.js"
    },
    "./models/gigaam-rnnt": {
      "types": "./dist/models/gigaam-rnnt/index.d.ts",
      "import": "./dist/models/gigaam-rnnt/index.js",
      "default": "./dist/models/gigaam-rnnt/index.js"
    },
    "./presets/*": {
      "types": "./dist/presets/*.d.ts",
      "import": "./dist/presets/*.js",
      "default": "./dist/presets/*.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json && node ./scripts/copy-runtime-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.examples.json --noEmit",
    "lint": "node ./node_modules/eslint/bin/eslint.js \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format": "node ./node_modules/prettier/bin/prettier.cjs --write \"src/**/*.ts\" \"tests/**/*.{ts,mjs}\" \"*.{json,md}\" \"docs/**/*.md\"",
    "format:check": "node ./node_modules/prettier/bin/prettier.cjs --check \"src/**/*.ts\" \"tests/**/*.{ts,mjs}\" \"*.{json,md}\" \"docs/**/*.md\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:package": "npm run build && node tests/smoke/package-tarball-smoke.mjs",
    "test:node-smoke": "npm run build && node tests/smoke/node-import-smoke.mjs",
    "test:browser-root": "npm run build && node tests/smoke/browser-root-import-graph.mjs",
    "test:offline-output-smoke": "npm run build && node tests/smoke/offline-output-smoke.mjs",
    "test:fixture-smoke": "npm run build && node tests/smoke/transcribe-fixture.mjs",
    "benchmark:whisper-mel": "npm run build && node tests/smoke/benchmark-whisper-mel.mjs",
    "benchmark:gigaam-mel": "npm run build && node tests/smoke/benchmark-gigaam-mel.mjs",
    "benchmark:whisper-beam": "vitest run tests/whisper-beam-search-benchmark.test.ts",
    "test:whisper-beam-reference": "npm run build && node tests/smoke/whisper-beam-reference.mjs",
    "docs:clean": "node -e \"require('fs').rmSync('.typedoc-site', { recursive: true, force: true })\"",
    "docs:api": "node ./node_modules/typedoc/bin/typedoc --options typedoc.json",
    "docs:build": "npm run docs:clean && npm run docs:api",
    "validate:whisper-variants": "npm run build && node tests/smoke/whisper-splitgraph-node-wasm-validate-v2.mjs --model-dir ${WHISPER_VARIANT_DIR:-/tmp/hf-publish/whisper-large-v3-turbo-onnx-4graph} --fixtures ${WHISPER_FIXTURES:-tests/fixtures} --variants fp32 fp16 q8 --no-align --no-strict --report ${WHISPER_REPORT:-docs/reports/whisper-large-v3-turbo-variant-validation.md}",
    "validate:whisper-base": "npm run build && node tests/smoke/whisper-splitgraph-node-wasm-validate-v2.mjs --model-dir ${WHISPER_BASE_DIR:-/tmp/whisper-base-4graph} --fixtures ${WHISPER_FIXTURES:-tests/fixtures} --variants fp32 fp16 --no-align --report ${WHISPER_REPORT:-docs/reports/whisper-base-variant-validation.md}",
    "validate:whisper-variants:python": "cd tools/whisper-onnx-export && .venv/bin/python validate_variants.py --model-dir ${WHISPER_VARIANT_DIR:-/tmp/hf-publish/whisper-large-v3-turbo-onnx-4graph} --fixtures ${WHISPER_FIXTURES:-tests/fixtures} --variants fp32 fp16 q8 --report ${WHISPER_REPORT:-docs/reports/whisper-large-v3-turbo-variant-validation.md}"
  },
  "dependencies": {
    "onnxruntime-node": "1.25.0-dev.20260228-6e72d31970",
    "onnxruntime-web": "^1.27.0-dev.20260506-673c3320fc",
    "pako": "^2.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "24.1.0",
    "@types/pako": "^2.0.4",
    "eslint": "^9.22.0",
    "prettier": "^3.6.2",
    "typedoc": "^0.28.17",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.26.1",
    "vitest": "4.0.18"
  }
}
